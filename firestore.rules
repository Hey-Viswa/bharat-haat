// Firestore Security Rules for E-commerce Marketplace
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isSeller() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "seller";
    }

    function isBuyer() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "buyer";
    }

    function isValidUserRole(role) {
      return role in ["buyer", "seller"];
    }

    // Users collection - each user can only access their own profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      // Allow reading seller profiles for public display (limited fields)
      allow read: if isAuthenticated() &&
                     resource.data.role == "seller" &&
                     request.query.limit <= 50;

      // Validate user data on create/update
      allow create: if isAuthenticated() &&
                       isOwner(userId) &&
                       isValidUserRole(request.resource.data.role) &&
                       request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated() &&
                       isOwner(userId) &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid;
    }

    // Products collection
    match /products/{productId} {
      // Public read access for browsing products (with limits)
      allow read: if isAuthenticated() &&
                     resource.data.is_active == true &&
                     request.query.limit <= 100;

      // Sellers can only manage their own products
      allow create: if isAuthenticated() &&
                       isSeller() &&
                       request.resource.data.seller_id == request.auth.uid;

      allow update, delete: if isAuthenticated() &&
                               isSeller() &&
                               resource.data.seller_id == request.auth.uid;

      // Allow sellers to read their own products (including inactive ones)
      allow read: if isAuthenticated() &&
                     isSeller() &&
                     resource.data.seller_id == request.auth.uid;
    }

    // Orders collection
    match /orders/{orderId} {
      // Buyers can read their own orders
      allow read: if isAuthenticated() &&
                     isBuyer() &&
                     resource.data.buyer_id == request.auth.uid;

      // Sellers can read orders for their products
      allow read: if isAuthenticated() &&
                     isSeller() &&
                     resource.data.seller_id == request.auth.uid;

      // Buyers can create orders
      allow create: if isAuthenticated() &&
                       isBuyer() &&
                       request.resource.data.buyer_id == request.auth.uid;

      // Sellers can update order status for their products
      allow update: if isAuthenticated() &&
                       isSeller() &&
                       resource.data.seller_id == request.auth.uid &&
                       // Only allow updating specific fields
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'tracking_number', 'expected_delivery',
                                  'status_history', 'updated_at']);

      // Buyers can update delivery address and notes before confirmation
      allow update: if isAuthenticated() &&
                       isBuyer() &&
                       resource.data.buyer_id == request.auth.uid &&
                       resource.data.status == "pending" &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['shipping_address', 'delivery_instructions', 'updated_at']);

      // Allow cancellation by buyer or seller under certain conditions
      allow update: if isAuthenticated() &&
                       ((isBuyer() && resource.data.buyer_id == request.auth.uid) ||
                        (isSeller() && resource.data.seller_id == request.auth.uid)) &&
                       resource.data.status in ["pending", "confirmed"] &&
                       request.resource.data.status == "cancelled";
    }

    // Payments collection
    match /payments/{paymentId} {
      // Users can read their own payment records
      allow read: if isAuthenticated() &&
                     resource.data.user_id == request.auth.uid;

      // Sellers can read payments for their orders
      allow read: if isAuthenticated() &&
                     isSeller() &&
                     resource.data.seller_id == request.auth.uid;

      // Only system/backend should create payments (not client-side)
      // In production, use Admin SDK or Cloud Functions for payment creation
      allow create: if false; // Disable client-side payment creation

      // Only allow updating payment status through secure backend
      allow update: if false; // Disable client-side payment updates
    }

    // Categories collection (read-only for clients)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin-only through backend
    }

    // Reviews collection
    match /reviews/{reviewId} {
      // Public read access to reviews
      allow read: if isAuthenticated();

      // Buyers can create reviews for products they purchased
      allow create: if isAuthenticated() &&
                       isBuyer() &&
                       request.resource.data.user_id == request.auth.uid &&
                       // Verify user actually purchased this product (would need additional check)
                       exists(/databases/$(database)/documents/orders/$(request.resource.data.order_id));

      // Users can update/delete their own reviews
      allow update, delete: if isAuthenticated() &&
                               resource.data.user_id == request.auth.uid;
    }

    // Wishlist collection
    match /wishlists/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Cart collection
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
  }
}

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    // Product images - sellers can only upload to their own folder
    match /products/{sellerId}/{allPaths=**} {
      allow read: if true; // Public read access for product images
      allow write: if request.auth != null &&
                      request.auth.uid == sellerId &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                      request.resource.contentType.matches('image/.*');
    }

    // User profile pictures
    match /users/{userId}/profile/{fileName} {
      allow read: if true; // Public read access for profile pictures
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 2 * 1024 * 1024 && // 2MB limit
                      request.resource.contentType.matches('image/.*');
    }

    // Order documents (receipts, invoices)
    match /orders/{orderId}/{fileName} {
      allow read: if request.auth != null &&
                     (isOrderBuyer(orderId) || isOrderSeller(orderId));
      allow write: if request.auth != null &&
                      isOrderSeller(orderId) &&
                      request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Helper function to check if user is order buyer
    function isOrderBuyer(orderId) {
      return firestore.get(/databases/(default)/documents/orders/$(orderId)).data.buyer_id == request.auth.uid;
    }

    // Helper function to check if user is order seller
    function isOrderSeller(orderId) {
      return firestore.get(/databases/(default)/documents/orders/$(orderId)).data.seller_id == request.auth.uid;
    }
  }
}

